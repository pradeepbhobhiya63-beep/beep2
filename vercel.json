{
  "version": 2,
  "headers": [
    {
      "source": "/max-pay.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"MaxPay.apk\"" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/server.js" }
  ]
}
